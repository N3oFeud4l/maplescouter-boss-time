{
  "manifest_version": 3,
  "name": "환산주스탯 보스 배율 시간 표시",
  "version": "1.3.1",
  "description": "일반/파티 보스컷 배율에 100%, 130%, 150%, 200% 각각을 20분 기준으로 한 예상 시간을 표시합니다.",
  "content_scripts": [
    {
      "matches": [
        "https://maplescouter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
